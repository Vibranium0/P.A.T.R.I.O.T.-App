
# === Monorepo .gitignore ===

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
*.pyc
venv/
ENV/
env/
**/venv/
**/ENV/
**/env/
**/__pycache__/

# Node.js
node_modules/
**/node_modules/
dist/
build/
**/dist/
**/build/
.vite/

# Environment & config
.env
.env.*
*.env

# Logs & temp
*.log
logs/
*.tmp
*.swp
*.swo
*.bak
shared_code_scan_report.txt
.shared_names.tmp

# macOS
.DS_Store

# VS Code & editors
.vscode/
.idea/

# Database & runtime
*.sqlite3
*.db
instance/

# Migrations
migrations/versions/*.pyc

# Frontend build artifacts (explicit, for clarity)
frontend/node_modules/
frontend/dist/
patriot/frontend/node_modules/
patriot/frontend/dist/
sentinel_login/frontend/node_modules/
sentinel_login/frontend/dist/

# Backend virtual environments (explicit, for clarity)
backend/venv/
backend/ENV/
backend/*.egg-info/
backend/*.egg
patriot/backend/venv/
patriot/backend/ENV/
patriot/backend/instance/
sentinel_login/backend/venv/
sentinel_login/backend/ENV/
sentinel_login/backend/instance/

# Static cache
backend/static/cache/

# Log files in root
patriot_backend.log
patriot_frontend.log
sentinel_backend.log
sentinel_frontend.log
nohup.out
